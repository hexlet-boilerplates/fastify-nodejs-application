<% layout("../layouts/application", { header: it.t('views.session.new.signIn') }) %>
<div class="mx-auto max-w-md rounded bg-white p-8 shadow-sm">
  <form action="<%= it.route('session') %>" method="post">
    <%~ include("../mixins/input", { entity: it.signInForm, propertyName: 'email', errors: it.errors, type: 'text' }) %>
    <%~ include("../mixins/input", { entity: it.signInForm, propertyName: 'password', errors: {}, type: 'password' }) %>
    <%~ include("../mixins/submit", { value: it.t('views.session.new.submit') }) %>
  </form>
</div>

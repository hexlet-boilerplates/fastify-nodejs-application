<!doctype html>
<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= it.t('appName') %></title>
    <link href="<%= it.assetPath('main.css') %>" rel="stylesheet">
  </head>
  <body class="flex min-h-screen flex-col bg-gray-50">
    <nav class="bg-white px-6 py-3">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-6">
        <a class="text-lg font-semibold" href="<%= it.route('root') %>"><%= it.t('appName') %></a>
        <ul class="flex flex-wrap items-center gap-4">
          <li><a class="hover:underline" href="<%= it.route('users') %>"><%= it.t('layouts.application.users') %></a></li>
        </ul>
        <ul class="ml-auto flex flex-wrap items-center gap-4">
          <% if (it.isAuthenticated()) { %>
          <li>
            <%~ include("../mixins/buttonTo", {
              action: it.route('session'),
              method: 'delete',
              class: 'cursor-pointer hover:underline',
              value: it.t('layouts.application.signOut'),
            }) %>
          </li>
          <% } else { %>
          <li><a class="hover:underline" href="<%= it.route('newSession') %>"><%= it.t('layouts.application.signIn') %></a></li>
          <li><a class="hover:underline" href="<%= it.route('newUser') %>"><%= it.t('layouts.application.signUp') %></a></li>
          <% } %>
        </ul>
      </div>
    </nav>
    <div class="mx-auto w-full max-w-5xl grow px-4">
      <% Object.entries(it.reply.flash() || {}).forEach(([type, messages]) => { %>
        <% messages.forEach((message) => { %>
        <div class="mt-4 rounded border px-4 py-3 <%= it.getAlertClass(type) %>" role="alert"><%= message %></div>
        <% }) %>
      <% }) %>

      <h1 class="mt-6 mb-4 text-4xl font-bold"><%= it.header ?? '' %></h1>
      <%~ it.body %>
    </div>

    <footer class="mt-10 bg-gray-800 text-gray-100">
      <div class="mx-auto max-w-5xl px-4 py-3">
        <a target="_blank" href="https://ru.hexlet.io">Hexlet</a>
      </div>
    </footer>
  </body>
</html>

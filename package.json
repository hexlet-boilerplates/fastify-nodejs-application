{
  "name": "fastify-nodejs-application",
  "version": "0.1.0",
  "type": "module",
  "description": "fastify-nodejs-application",
  "main": "./server/plugin.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "test": "jest --verbose --runInBand",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "build": "webpack",
    "start": "fastify start server/plugin.js -l debug -P -o"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/__tests__/helpers/"
    ],
    "setupFiles": [
      "dotenv/config"
    ]
  },
  "author": "Stanislav Dzisiak",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexlet-boilerplates/fastify-nodejs-application.git"
  },
  "bugs": {
    "url": "https://github.com/hexlet-boilerplates/fastify-nodejs-application/issues"
  },
  "homepage": "https://github.com/hexlet-boilerplates/fastify-nodejs-application.git#readme",
  "overrides": {
    "better-sqlite3": "^13.0.2"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.1",
    "@fastify/passport": "^4.0.4",
    "@fastify/secure-session": "^8.4.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/static": "^10.1.7",
    "@fastify/view": "^12.0.1",
    "@hexlet/fastify-method-override": "git+https://github.com/hexlet-components/fastify-method-override.git",
    "@vscode/sqlite3": "^5.1.2",
    "bootstrap": "^5.3.8",
    "eta": "^4.6.0",
    "fastify": "^5.12.7",
    "fastify-cli": "^8.0.3",
    "fastify-error-page": "^4.0.0",
    "fastify-objectionjs": "^2.0.1",
    "fastify-reverse-routes": "^3.0.0",
    "i18next": "^26.5.7",
    "jquery": "^4.0.0",
    "knex": "^3.3.0",
    "lodash": "^4.18.1",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-check-updates": "^23.1.1",
    "objection": "^3.1.5",
    "objection-unique": "^1.2.2",
    "pino-pretty": "^13.2.0",
    "qs": "^6.16.1",
    "sqlite3": "^6.0.1",
    "webpack": "^5.112.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "css-loader": "^7.1.5",
    "dotenv": "^18.0.9",
    "jest": "^30.5.2",
    "jest-cli": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "style-loader": "^4.0.0",
    "webpack-cli": "^7.2.3"
  },
  "allowScripts": {
    "sqlite3": true,
    "@vscode/sqlite3": true,
    "unrs-resolver": true,
    "@parcel/watcher": false
  }
}

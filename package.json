{
  "name": "fastify-nodejs-application",
  "version": "0.1.0",
  "type": "module",
  "description": "fastify-nodejs-application",
  "main": "./server/plugin.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "test": "jest --verbose --runInBand",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "lint:fix": "oxfmt && oxlint --fix",
    "build": "webpack",
    "start": "fastify start server/plugin.js -l debug -P -o"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/__tests__/helpers/"
    ],
    "setupFiles": [
      "dotenv/config"
    ]
  },
  "author": "Stanislav Dzisiak",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexlet-boilerplates/fastify-nodejs-application.git"
  },
  "bugs": {
    "url": "https://github.com/hexlet-boilerplates/fastify-nodejs-application/issues"
  },
  "homepage": "https://github.com/hexlet-boilerplates/fastify-nodejs-application.git#readme",
  "dependencies": {
    "@fastify/formbody": "^9.0.1",
    "@fastify/passport": "^4.0.4",
    "@fastify/secure-session": "^8.4.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/static": "^10.1.7",
    "@fastify/view": "^12.0.1",
    "@hexlet/fastify-method-override": "git+https://github.com/hexlet-components/fastify-method-override.git",
    "bootstrap": "^5.3.8",
    "drizzle-orm": "^1.0.0-beta.22",
    "eta": "^4.6.0",
    "fastify": "^5.12.7",
    "fastify-cli": "^8.0.3",
    "fastify-error-page": "^4.0.0",
    "fastify-reverse-routes": "^3.0.0",
    "i18next": "^26.5.10",
    "jquery": "^4.0.0",
    "lodash": "^4.18.1",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-check-updates": "^23.1.1",
    "pino-pretty": "^13.2.0",
    "qs": "^6.16.1",
    "webpack": "^5.112.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "css-loader": "^7.1.5",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^1.0.0-beta.22",
    "jest": "^30.5.2",
    "jest-cli": "^30.5.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "pino-pretty": "^13.2.0",
    "style-loader": "^4.0.0",
    "webpack-cli": "^7.2.3"
  },
  "allowScripts": {
    "unrs-resolver": true,
    "@parcel/watcher": false,
    "esbuild": false
  }
}
